 /*****************************************************************************/
+/* Source-owned PCM selection/readback. This describes a candidate format, not
+ * qualification of USB framing or firmware audio behavior. */
+
+typedef struct {
+    MMVoiceAudioToken token;
+    gboolean selected;
+} AudioConfiguration;
+
+static void
+voice_audio_fail_closed (MMSharedSimtech *self)
+{
+    get_private (self)->audio_failed = TRUE;
+    mm_iface_modem_voice_audio_invalidate (MM_IFACE_MODEM_VOICE (self));
+}
+
+static gboolean
+configuration_current (GTask *task, gboolean pending)
+{
+    MMSharedSimtech *self = g_task_get_source_object (task);
+    AudioConfiguration *ctx = g_task_get_task_data (task);
+    return !get_private (self)->audio_failed &&
+        !g_cancellable_is_cancelled (g_task_get_cancellable (task)) &&
+        mm_iface_modem_voice_audio_configuration_is_current (
+            MM_IFACE_MODEM_VOICE (self), ctx->token, pending);
+}
+
+static gboolean
+configuration_envelope_stale (GTask *task, gboolean pending)
+{
+    if (configuration_current (task, pending))
+        return FALSE;
+    g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_CANCELLED,
+                             "Voice audio lifecycle is no longer current");
+    g_object_unref (task);
+    return TRUE;
+}
+
+static gboolean
+configuration_envelope_begin (GTask *task, gboolean preserve_configured)
+{
+    MMSharedSimtech *self = g_task_get_source_object (task);
+    Private *priv = get_private (self);
+    AudioConfiguration *ctx = g_new0 (AudioConfiguration, 1);
+    g_task_set_check_cancellable (task, FALSE);
+    g_task_set_task_data (task, ctx, g_free);
+    if (priv->audio_failed || priv->audio_configuring || priv->audio_physical) {
+        voice_audio_fail_closed (self);
+        return !configuration_envelope_stale (task, FALSE);
+    }
+    if (preserve_configured)
+        ctx->token = mm_iface_modem_voice_audio_get_configuration_token (MM_IFACE_MODEM_VOICE (self));
+    if (!ctx->token.operation)
+        ctx->token = mm_iface_modem_voice_audio_begin_configuration (MM_IFACE_MODEM_VOICE (self));
+    return !configuration_envelope_stale (task, FALSE);
+}
+
+static void
+configuration_marker (GTask *task, gboolean success)
+{
+    AudioConfiguration *ctx = g_task_get_task_data (task);
+    mm_obj_msg (g_task_get_source_object (task),
+                "voice-audio contract=1 generation=%" G_GUINT64_FORMAT
+                " operation=%" G_GUINT64_FORMAT " selection=%s readback=%s",
+                ctx->token.generation, ctx->token.operation,
+                ctx->selected ? "ok" : "failed",
+                success ? "ok" : (ctx->selected ? "failed" : "not-run"));
+}
+
+static void
+configuration_failed (GTask *task, GError *error)
+{
+    MMSharedSimtech *self = g_task_get_source_object (task);
+    AudioConfiguration *ctx = g_task_get_task_data (task);
+    Private *priv = get_private (self);
+
+    /* Bind the failure to the attempted operation, before invalidating it.
+     * Cancellation is an outcome too; owner/token identity still gates logging. */
+    if (!priv->audio_failed && mm_iface_modem_voice_audio_configuration_is_current (
+            MM_IFACE_MODEM_VOICE (self), ctx->token, TRUE))
+        configuration_marker (task, FALSE);
+    priv->audio_configuring = FALSE;
+    voice_audio_fail_closed (self);
+    if (error)
+        g_task_return_error (task, error);
+    else
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "PCM configuration was not confirmed");
+    g_object_unref (task);
+}
+
+static void
+cpcmfrm_readback_ready (MMBaseModem *self, GAsyncResult *res, GTask *task)
+{
+    GError *error = NULL;
+    const gchar *response = mm_base_modem_at_command_finish (self, res, &error);
+    g_autofree gchar *normalized = response ? g_strdup (response) : NULL;
+    g_autoptr(MMCallAudioFormat) format = NULL;
+    AudioConfiguration *ctx = g_task_get_task_data (task);
+    Private *priv = get_private (MM_SHARED_SIMTECH (self));
+
+    /* Exact single selector result; no duplicate lines, inferred rates or
+     * acceptance of a partial/unsuccessful command completion. */
+    if (!response || !configuration_current (task, TRUE) ||
+        g_strcmp0 (g_strstrip (normalized), "+CPCMFRM: 1")) {
+        configuration_failed (task, error);
+        return;
+    }
+    format = mm_call_audio_format_new ();
+    mm_call_audio_format_set_encoding (format, "pcm");
+    mm_call_audio_format_set_resolution (format, "s16le");
+    mm_call_audio_format_set_rate (format, 16000);
+    if (!mm_iface_modem_voice_audio_publish_configured (MM_IFACE_MODEM_VOICE (self), ctx->token, format) ||
+        !configuration_current (task, FALSE)) {
+        configuration_failed (task, NULL);
+        return;
+    }
+    priv->audio_configuring = FALSE;
+    configuration_marker (task, TRUE);
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+cpcmfrm_selection_ready (MMBaseModem *self, GAsyncResult *res, GTask *task)
+{
+    GError *error = NULL;
+    const gchar *response = mm_base_modem_at_command_finish (self, res, &error);
+    AudioConfiguration *ctx = g_task_get_task_data (task);
+
+    if (!response || !configuration_current (task, TRUE)) {
+        configuration_failed (task, error);
+        return;
+    }
+    ctx->selected = TRUE;
+    mm_base_modem_at_command_full (self,
+        MM_IFACE_PORT_AT (mm_base_modem_peek_port_primary (self)),
+        "+CPCMFRM?", 3, FALSE, FALSE, g_task_get_cancellable (task),
+        (GAsyncReadyCallback) cpcmfrm_readback_ready, task);
+}
+
+static void
+configure_voice_audio (MMSharedSimtech *self, MMVoiceAudioToken token,
+                       GAsyncReadyCallback callback, gpointer user_data)
+{
+    Private *priv = get_private (self);
+    g_autoptr(GCancellable) cancellable = g_cancellable_new ();
+    GTask *task = g_task_new (self, cancellable, callback, user_data);
+    AudioConfiguration *ctx = g_new0 (AudioConfiguration, 1);
+
+    g_task_set_check_cancellable (task, FALSE);
+    g_task_set_task_data (task, ctx, g_free);
+    if (priv->audio_failed || priv->audio_configuring || priv->audio_physical) {
+        /* Never put a selection behind an unresolved physical transition. */
+        voice_audio_fail_closed (self);
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_WRONG_STATE,
+                                 "Audio transport admission is closed");
+        g_object_unref (task);
+        return;
+    }
+    ctx->token = token;
+    if (!configuration_current (task, TRUE)) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_CANCELLED,
+                                 "PCM configuration owner is no longer current");
+        g_object_unref (task);
+        return;
+    }
+    priv->audio_configuring = TRUE;
+    mm_base_modem_at_command_full (MM_BASE_MODEM (self),
+        MM_IFACE_PORT_AT (mm_base_modem_peek_port_primary (MM_BASE_MODEM (self))),
+        "+CPCMFRM=1", 3, FALSE, FALSE, cancellable,
+        (GAsyncReadyCallback) cpcmfrm_selection_ready, task);
+}
+
