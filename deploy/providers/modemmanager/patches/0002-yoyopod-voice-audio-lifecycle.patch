+
+void
+mm_iface_modem_voice_audio_invalidate (MMIfaceModemVoice *self)
+{
+    InCallEventContext *ctx = peek_in_call_event_context (self);
+    g_autoptr(MMPort) old_port = NULL;
+    g_autoptr(GCancellable) setup = NULL;
+    g_autoptr(GCancellable) cleanup = NULL;
+
+    if (!ctx)
+        return;
+    /* Detach all owned state before observable cancellation/port notifications.
+     * Those observers may start new work; this invocation never clears it. */
+    ctx->accepting_results = FALSE;
+    if (ctx->generation == G_MAXUINT64)
+        ctx->exhausted = TRUE;
+    else
+        ctx->generation++;
+    ctx->configuration_pending = FALSE;
+    ctx->channel_pending = FALSE;
+    ctx->audio_exports_suspended = FALSE;
+    if (ctx->check_id) {
+        g_source_remove (ctx->check_id);
+        ctx->check_id = 0;
+    }
+    setup = g_steal_pointer (&ctx->setup_cancellable);
+    cleanup = g_steal_pointer (&ctx->cleanup_cancellable);
+    old_port = g_steal_pointer (&ctx->audio_port);
+    g_clear_object (&ctx->audio_format);
+    g_clear_object (&ctx->configured_audio_format);
+    ctx->in_call_state = FALSE;
+    if (old_port) {
+        g_object_freeze_notify (G_OBJECT (old_port));
+        if (mm_port_get_connected (old_port))
+            mm_port_set_connected (old_port, FALSE);
+    }
+    voice_audio_clear_call_properties (self, old_port);
+    if (setup)
+        g_cancellable_cancel (setup);
+    if (cleanup)
+        g_cancellable_cancel (cleanup);
+}
