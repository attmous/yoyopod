+    if (!voice_audio_accepting (self, ctx) || ctx->exhausted ||
+        !ctx->configured_audio_format || !ctx->generation || !ctx->configuration_operation)
+        return (MMVoiceAudioToken) { 0, 0 };
+    return (MMVoiceAudioToken) { ctx->generation, ctx->configuration_operation };
