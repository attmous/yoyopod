+
+void
+mm_iface_modem_voice_audio_invalidate (MMIfaceModemVoice *self)
+{
+    InCallEventContext *ctx = peek_in_call_event_context (self);
+
+    if (!ctx)
+        return;
+    /* Fence callbacks before cancellation or changes to observable objects. */
+    ctx->accepting_results = FALSE;
+    if (ctx->generation == G_MAXUINT64)
+        ctx->exhausted = TRUE;
+    else
+        ctx->generation++;
+    ctx->configuration_pending = FALSE;
+    ctx->channel_pending = FALSE;
+    if (ctx->check_id) {
+        g_source_remove (ctx->check_id);
+        ctx->check_id = 0;
+    }
+    if (ctx->setup_cancellable)
+        g_cancellable_cancel (ctx->setup_cancellable);
+    if (ctx->cleanup_cancellable)
+        g_cancellable_cancel (ctx->cleanup_cancellable);
+    g_clear_object (&ctx->setup_cancellable);
+    g_clear_object (&ctx->cleanup_cancellable);
+    voice_audio_disconnect (ctx);
+    g_clear_object (&ctx->audio_port);
+    g_clear_object (&ctx->audio_format);
+    g_clear_object (&ctx->configured_audio_format);
+    ctx->in_call_state = FALSE;
+    voice_audio_clear_call_properties (self, NULL);
+}
+
+static gboolean
+voice_audio_next_operation (MMIfaceModemVoice *self, InCallEventContext *ctx,
+                            guint64 *operation)
+{
+    if (ctx->exhausted || *operation == G_MAXUINT64) {
+        ctx->exhausted = TRUE;
+        mm_iface_modem_voice_audio_invalidate (self);
+        return FALSE;
+    }
+    ++*operation;
+    return TRUE;
+}
+
+MMVoiceAudioToken
+mm_iface_modem_voice_audio_begin_configuration (MMIfaceModemVoice *self)
+{
+    InCallEventContext *ctx = get_in_call_event_context (self);
+
+    if (!voice_audio_owner_available (self) ||
+        !voice_audio_next_operation (self, ctx, &ctx->configuration_operation))
+        return (MMVoiceAudioToken) { 0, 0 };
+    ctx->accepting_results = TRUE;
+    ctx->configuration_pending = TRUE;
+    /* A failed refresh must not reuse the preceding configuration. */
+    g_clear_object (&ctx->configured_audio_format);
+    update_audio_settings_in_ongoing_calls (self);
+    return (MMVoiceAudioToken) { ctx->generation, ctx->configuration_operation };
+}
+
+gboolean
+mm_iface_modem_voice_audio_publish_configured (MMIfaceModemVoice *self,
+                                              MMVoiceAudioToken token,
+                                              MMCallAudioFormat *format)
+{
+    InCallEventContext *ctx = peek_in_call_event_context (self);
+
+    if (!voice_audio_accepting (self, ctx) || !ctx->configuration_pending ||
+        token.generation != ctx->generation || token.operation != ctx->configuration_operation)
+        return FALSE;
+    ctx->configuration_pending = FALSE;
+    g_set_object (&ctx->configured_audio_format, format);
+    update_audio_settings_in_ongoing_calls (self);
+    return TRUE;
+}
+
+MMCallAudioFormat *
+mm_iface_modem_voice_audio_dup_configured (MMIfaceModemVoice *self)
+{
+    InCallEventContext *ctx = peek_in_call_event_context (self);
+
+    return (voice_audio_accepting (self, ctx) && ctx->configured_audio_format) ?
+        g_object_ref (ctx->configured_audio_format) : NULL;
+}
+
+MMVoiceAudioToken
+mm_iface_modem_voice_audio_begin_channel (MMIfaceModemVoice *self)
+{
+    InCallEventContext *ctx = get_in_call_event_context (self);
+
+    if (!voice_audio_accepting (self, ctx) ||
+        !voice_audio_next_operation (self, ctx, &ctx->channel_operation))
+        return (MMVoiceAudioToken) { 0, 0 };
+    ctx->channel_pending = TRUE;
+    /* Fence first, then cancel. Old completions must not clear these pointers. */
+    if (ctx->setup_cancellable)
+        g_cancellable_cancel (ctx->setup_cancellable);
+    if (ctx->cleanup_cancellable)
+        g_cancellable_cancel (ctx->cleanup_cancellable);
+    g_clear_object (&ctx->setup_cancellable);
+    g_clear_object (&ctx->cleanup_cancellable);
+    return (MMVoiceAudioToken) { ctx->generation, ctx->channel_operation };
+}
+
+static gboolean
+voice_audio_channel_matches (MMIfaceModemVoice *self, InCallEventContext *ctx, MMVoiceAudioToken token)
+{
+    return voice_audio_accepting (self, ctx) && token.generation == ctx->generation &&
+        token.operation && token.operation == ctx->channel_operation;
+}
+
+GCancellable *
+mm_iface_modem_voice_audio_ref_channel_cancellable (MMIfaceModemVoice *self,
+                                                   gboolean cleanup)
+{
+    InCallEventContext *ctx = peek_in_call_event_context (self);
+    GCancellable *operation;
+    GCancellable *modem;
+
+    if (!voice_audio_accepting (self, ctx) || !ctx->channel_pending)
+        return NULL;
+    modem = mm_base_modem_peek_cancellable (MM_BASE_MODEM (self));
+    operation = cleanup ? ctx->cleanup_cancellable : ctx->setup_cancellable;
+    if (!modem || g_cancellable_is_cancelled (modem) ||
+        !operation || g_cancellable_is_cancelled (operation))
+        return NULL;
+    return g_object_ref (operation);
+}
+
+gboolean
+mm_iface_modem_voice_audio_commit_channel (MMIfaceModemVoice *self,
+                                          MMVoiceAudioToken token,
+                                          MMPort *port,
+                                          MMCallAudioFormat *format)
+{
+    InCallEventContext *ctx = peek_in_call_event_context (self);
+
+    if (!voice_audio_channel_matches (self, ctx, token) || !ctx->channel_pending)
+        return FALSE;
+    ctx->channel_pending = FALSE;
+    if (ctx->audio_port != port)
+        voice_audio_disconnect (ctx);
+    g_set_object (&ctx->audio_port, port);
+    g_set_object (&ctx->audio_format, format);
+    ctx->in_call_state = TRUE;
+    update_audio_settings_in_ongoing_calls (self);
+    return TRUE;
+}
+
+gboolean
+mm_iface_modem_voice_audio_clear_channel (MMIfaceModemVoice *self,
+                                         MMVoiceAudioToken token)
+{
+    InCallEventContext *ctx = peek_in_call_event_context (self);
+
+    if (!voice_audio_channel_matches (self, ctx, token) || !ctx->channel_pending)
+        return FALSE;
+    ctx->channel_pending = FALSE;
+    voice_audio_disconnect (ctx);
+    g_clear_object (&ctx->audio_port);
+    g_clear_object (&ctx->audio_format);
+    ctx->in_call_state = FALSE;
+    voice_audio_clear_call_properties (self, ctx);
+    return TRUE;
 }
 
