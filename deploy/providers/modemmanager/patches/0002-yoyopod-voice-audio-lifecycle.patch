+gboolean
+mm_iface_modem_voice_audio_suspend_channel (MMIfaceModemVoice *self,
+                                             GCancellable *operation,
+                                             gboolean cleanup,
+                                             MMVoiceAudioToken *configuration)
+{
+    InCallEventContext *ctx = peek_in_call_event_context (self);
+    MMVoiceAudioToken captured = { 0, 0 };
+    g_autoptr(GCancellable) current = mm_iface_modem_voice_audio_ref_channel_cancellable (self, cleanup);
+
+    if (configuration)
+        *configuration = captured;
+    if (!operation || current != operation)
+        return FALSE;
+    captured = (MMVoiceAudioToken) { ctx->generation, ctx->configuration_operation };
+    ctx->audio_exports_suspended = TRUE;
+    update_audio_settings_in_ongoing_calls (self);
+    /* Property notifications may have invalidated or committed a new channel. */
+    g_clear_object (&current);
+    current = mm_iface_modem_voice_audio_ref_channel_cancellable (self, cleanup);
+    ctx = peek_in_call_event_context (self);
+    if (!current || current != operation || !ctx || !ctx->audio_exports_suspended ||
+        !mm_iface_modem_voice_audio_configuration_is_current (self, captured, FALSE))
+        return FALSE;
+    if (configuration)
+        *configuration = captured;
+    return TRUE;
+}
