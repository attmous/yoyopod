+/* Snapshot the update so reentrant property notifications cannot let an old
+ * walk overwrite a newer generation/operation. Hold references through notify. */
+typedef struct {
+    MMIfaceModemVoice *self;
+    InCallEventContext *ctx;
+    guint64 generation, configuration_operation, channel_operation;
+    gboolean suspended;
+    gboolean clear;
+    MMPort *port;
+    MMCallAudioFormat *format;
+    GCancellable *operation;
+} VoiceAudioUpdate;
+
+static gboolean
+voice_audio_update_is_current (VoiceAudioUpdate *update)
+{
+    InCallEventContext *ctx = peek_in_call_event_context (update->self);
+    return ctx && ctx == update->ctx && ctx->generation == update->generation &&
+        ctx->configuration_operation == update->configuration_operation &&
+        ctx->channel_operation == update->channel_operation &&
+        ctx->audio_exports_suspended == update->suspended &&
+        (!update->suspended ||
+         (voice_audio_accepting (update->self, ctx) && ctx->channel_pending &&
+          update->operation && !g_cancellable_is_cancelled (update->operation) &&
+          (ctx->setup_cancellable == update->operation || ctx->cleanup_cancellable == update->operation)));
+}
+
+static void
+voice_audio_collect_call (MMBaseCall *call, GPtrArray *calls)
+{
+    g_ptr_array_add (calls, g_object_ref (call));
+}
+
+static void
+call_list_apply_audio_settings (MMBaseCall *call, VoiceAudioUpdate *update)
+{
+    gboolean terminal = mm_base_call_get_state (call) == MM_CALL_STATE_TERMINATED;
+
+    if (!voice_audio_update_is_current (update))
+        return;
+    if (terminal && !update->clear && !update->suspended)
+        return;
+    /* Deliver notifications after both property writes. Invalidation inside a
+     * notify then clears them without a following stale write from this call. */
+    g_object_freeze_notify (G_OBJECT (call));
+    if (update->suspended && !update->clear) {
+        /* Export-only hold: change_audio_settings(NULL) would disconnect the
+         * shared port and release the Call's ownership. Keep both untouched. */
+        mm_gdbus_call_set_audio_port (MM_GDBUS_CALL (call), "");
+        if (!terminal && voice_audio_update_is_current (update))
+            mm_gdbus_call_set_audio_format (MM_GDBUS_CALL (call),
+                                            mm_call_audio_format_get_dictionary (update->format));
+    } else
+        mm_base_call_change_audio_settings (call, update->clear ? NULL : update->port,
+                                            terminal ? NULL : update->format);
+    g_object_thaw_notify (G_OBJECT (call));
+}
+
+static void
+voice_audio_collect_port (GPtrArray *ports, MMPort *port)
+{
+    guint i;
+    if (!port)
+        return;
+    for (i = 0; i < ports->len; i++)
+        if (g_ptr_array_index (ports, i) == port)
+            return;
+    g_ptr_array_add (ports, g_object_ref (port));
+}
+
+static void
+voice_audio_update_calls (MMIfaceModemVoice *self, MMBaseCall *single, gboolean clear,
+                          MMPort *frozen_port)
+{
+    InCallEventContext *ctx = peek_in_call_event_context (self);
+    g_autoptr(MMCallList) list = NULL;
+    g_autoptr(MMPort) port = NULL;
+    g_autoptr(MMCallAudioFormat) format = NULL;
+    g_autoptr(GCancellable) operation = NULL;
+    g_autoptr(GPtrArray) calls = g_ptr_array_new_with_free_func (g_object_unref);
+    g_autoptr(GPtrArray) ports = g_ptr_array_new_with_free_func (g_object_unref);
+    VoiceAudioUpdate update;
+    guint i;
+
+    if (!ctx) {
+        if (frozen_port)
+            g_object_thaw_notify (G_OBJECT (frozen_port));
+        return;
+    }
+    if (ctx->audio_port)
+        port = g_object_ref (ctx->audio_port);
+    if (!clear && !ctx->audio_exports_suspended && ctx->audio_format)
+        format = g_object_ref (ctx->audio_format);
+    else if (ctx->configured_audio_format)
+        format = g_object_ref (ctx->configured_audio_format);
+    if (ctx->audio_exports_suspended) {
+        operation = mm_iface_modem_voice_audio_ref_channel_cancellable (self, FALSE);
+        if (!operation)
+            operation = mm_iface_modem_voice_audio_ref_channel_cancellable (self, TRUE);
+    }
+    update = (VoiceAudioUpdate) { self, ctx, ctx->generation,
+        ctx->configuration_operation, ctx->channel_operation,
+        ctx->audio_exports_suspended, clear, port, format, operation };
+    if (single)
+        voice_audio_collect_call (single, calls);
+    else {
+        g_object_get (self, MM_IFACE_MODEM_VOICE_CALL_LIST, &list, NULL);
+        if (list)
+            mm_call_list_foreach (list, (MMCallListForeachFunc) voice_audio_collect_call, calls);
+    }
+    /* Snapshot exact ownership, including terminal Calls retaining an older
+     * port and suspended Calls whose exported AudioPort is deliberately empty. */
+    voice_audio_collect_port (ports, frozen_port);
+    voice_audio_collect_port (ports, port);
+    for (i = 0; i < calls->len; i++) {
+        MMBaseCall *call = g_ptr_array_index (calls, i);
+        g_autoptr(MMPort) owned = mm_base_call_ref_audio_port (call);
+        voice_audio_collect_port (ports, owned);
+        g_object_freeze_notify (G_OBJECT (call));
+    }
+    for (i = 0; i < ports->len; i++) {
+        MMPort *owned = g_ptr_array_index (ports, i);
+        if (owned != frozen_port)
+            g_object_freeze_notify (G_OBJECT (owned));
+    }
+    for (i = 0; i < calls->len; i++)
+        call_list_apply_audio_settings (g_ptr_array_index (calls, i), &update);
+    /* Context and paired Call exports are now settled. Connected observers may
+     * invalidate/commit, with all Calls still frozen and no later stale writes. */
+    for (i = 0; i < ports->len; i++)
+        g_object_thaw_notify (G_OBJECT (g_ptr_array_index (ports, i)));
+    for (i = 0; i < calls->len; i++)
+        g_object_thaw_notify (G_OBJECT (g_ptr_array_index (calls, i)));
 }
 
