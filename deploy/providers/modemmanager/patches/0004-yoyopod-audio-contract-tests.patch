+static void
+test_reentrant_publication_invalidation_has_no_success_marker (void)
+{
+    VoiceFixture *f = voice_fixture_new_uninitialized ();
+    MMBaseCall *call;
+    MMVoiceAudioToken attempted, after;
+    gsize offset;
+    g_autofree gchar *log = NULL;
+
