{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoyopod.local/schemas/modemmanager-manifest-v1.json",
  "title": "Candidate ModemManager provider manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repo_sha",
    "ci_run_id",
    "source_version",
    "package_version",
    "architecture",
    "source_lock_sha256",
    "patch_series_sha256",
    "profile_sha256",
    "daemon_sha256",
    "packages",
    "source_files",
    "reports"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repo_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "ci_run_id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "source_version": {
      "const": "1.24.0-1+deb13u1"
    },
    "package_version": {
      "const": "1.24.0-1+deb13u1+yoyopod1"
    },
    "architecture": {
      "const": "arm64"
    },
    "source_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "patch_series_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "daemon_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "sha256",
          "name",
          "version",
          "architecture"
        ],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\:]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9+.-]+$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "architecture": {
            "enum": [
              "arm64",
              "all"
            ]
          }
        }
      }
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "sha256"
        ],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\:]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "sha256"
        ],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\:]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
