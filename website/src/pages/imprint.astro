---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Imprint | yoyopod" description="Legal notice (Impressum) for yoyopod.com.">
	<Header />
	<main class="section legal">
		<div class="container narrow">
			<h1>Imprint</h1>
			<div class="card placeholder">
				<p>
					<strong>Placeholder: complete before public launch.</strong> This page must carry the
					operator details required by § 5 DDG (Angaben gemäß § 5 DDG).
				</p>
			</div>

			<h2>Operator</h2>
			<dl>
				<dt>Name</dt>
				<dd>[name]</dd>
				<dt>Address</dt>
				<dd>[street, postal code, city, Germany]</dd>
				<dt>Contact</dt>
				<dd>[email address]</dd>
			</dl>
		</div>
	</main>
	<Footer />
</BaseLayout>

<style>
	.legal h2 {
		font-size: 1.3rem;
		margin-top: 2.25rem;
	}

	.legal dd {
		color: var(--ink-75);
	}

	.placeholder {
		border: 2px dashed var(--cyan);
		margin-bottom: 2rem;
	}

	.placeholder p {
		margin-bottom: 0;
	}

	dl {
		margin: 0;
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.6rem 1.5rem;
	}

	dt {
		font-weight: 700;
	}

	dd {
		margin: 0;
	}
</style>
