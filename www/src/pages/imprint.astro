---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Impressum | yoyopod" description="Impressum / legal notice for yoyopod.com.">
	<Header />
	<main class="section legal">
		<div class="container narrow">
			<div lang="de">
				<h1>Impressum</h1>
				<p class="ddg">Angaben gemäß § 5 DDG</p>

				<dl>
					<dt>Name</dt>
					<dd>Moustafa Attia</dd>
					<dt>Anschrift</dt>
					<dd>Hermannstraße 6, 73033 Göppingen, Deutschland</dd>
					<dt>Kontakt</dt>
					<dd><a href="mailto:privacy@yoyopod.com">privacy@yoyopod.com</a></dd>
				</dl>
			</div>

			<hr class="lang-sep" />

			<div lang="en">
				<h2>Imprint (English)</h2>
				<p class="ddg">Information in accordance with § 5 DDG (German Digital Services Act)</p>

				<dl>
					<dt>Name</dt>
					<dd>Moustafa Attia</dd>
					<dt>Address</dt>
					<dd>Hermannstraße 6, 73033 Göppingen, Germany</dd>
					<dt>Contact</dt>
					<dd><a href="mailto:privacy@yoyopod.com">privacy@yoyopod.com</a></dd>
				</dl>
			</div>
		</div>
	</main>
	<Footer />
</BaseLayout>

<style>
	.legal h2 {
		font-size: 1.3rem;
		margin-top: 0;
	}

	.legal dd {
		color: var(--ink-75);
	}

	.ddg {
		color: var(--ink-50);
		font-size: 0.9rem;
	}

	.lang-sep {
		border: none;
		border-top: 1.5px solid var(--ink-22);
		margin-block: 2.5rem;
	}

	dl {
		margin: 0;
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.6rem 1.5rem;
	}

	dt {
		font-weight: 700;
	}

	dd {
		margin: 0;
	}
</style>
